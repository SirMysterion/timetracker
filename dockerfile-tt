# This file is for development work. Not suitable for production.
FROM php:8.5.13-apache-trixie

# Use the default production configuration.
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Override with custom settings.
# COPY config/php_tt.ini $PHP_INI_DIR/conf.d/

# Install mysqli extension.
RUN docker-php-ext-install mysqli

# Install gd extension.
RUN apt-get update && apt-get install libpng-dev libfreetype6-dev -y \
 && docker-php-ext-configure gd --with-freetype \
 && docker-php-ext-install gd 

# Install ldap extension.
RUN apt-get install libldap2-dev -y \
  && docker-php-ext-install ldap
# TODO: check if ldap works, as the above is missing this step:
# && docker-php-ext-configure ldap --with-libdir=lib/x86_64-linux-gnu/ && \

# Cleanup. The intention was to keep image size down.
# RUN rm -rf /var/lib/apt/lists/*
#
# The above does not work. Files are removed, but
# image files (zipped or not) are not getting smaller. Why?

# Copy application source code to /var/www/html/.
COPY . /var/www/html/
# Create configuration file.
RUN cp /var/www/html/WEB-INF/config.php.dist /var/www/html/WEB-INF/config.php
# Replace DSN value to something connectable to a Docker container running mariadb.
RUN sed -i "s|mysqli://root:no@localhost/dbname|mysqli://anuko_user:anuko_pw@anuko_db/timetracker|g" /var/www/html/WEB-INF/config.php
# Note that db is defined as anuko_db/timetracker where anuko_db is service name and timetracker is db name.
# See docker-compose.yml for details.

# Remove build-only files that would otherwise stay web-readable in the webroot.
# config.php.dist has already been used to generate config.php above; mysql.sql
# is only needed by the database image, not here.
RUN rm -f /var/www/html/WEB-INF/config.php.dist /var/www/html/mysql.sql

# Harden Apache. Deny direct HTTP access to WEB-INF, the .git directory, and
# build/VCS files. The one exception is generated chart images, which charts.php
# serves from WEB-INF/templates_c. Written to conf-enabled so it always loads,
# regardless of AllowOverride (this image ignores .htaccess by default).
RUN a2enmod headers
RUN { \
      echo 'ServerTokens Prod'; \
      echo 'ServerSignature Off'; \
      echo 'TraceEnable Off'; \
      echo 'Header always set X-Content-Type-Options "nosniff"'; \
      echo 'Header always set X-Frame-Options "SAMEORIGIN"'; \
      echo 'Header always set Referrer-Policy "same-origin"'; \
      echo '<Files "cron.php">'; \
      echo '  Require local'; \
      echo '</Files>'; \
      echo '<Directory /var/www/html>'; \
      echo '  Options -Indexes'; \
      echo '</Directory>'; \
      echo '<Directory /var/www/html/api>'; \
      echo '  FallbackResource /api/index.php'; \
      echo '</Directory>'; \
      echo '<Directory /var/www/html/WEB-INF>'; \
      echo '  Require all denied'; \
      echo '</Directory>'; \
      echo '<DirectoryMatch "^/var/www/html/\.git">'; \
      echo '  Require all denied'; \
      echo '</DirectoryMatch>'; \
      echo '<FilesMatch "(?i)\.(sql|dist|ya?ml)$">'; \
      echo '  Require all denied'; \
      echo '</FilesMatch>'; \
      echo '<FilesMatch "(?i)^(dockerfile|\.git|\.env|\.docker)">'; \
      echo '  Require all denied'; \
      echo '</FilesMatch>'; \
      echo '<Directory /var/www/html/WEB-INF/templates_c>'; \
      echo '  <FilesMatch "^chart_[0-9a-f]+\.png$">'; \
      echo '    Require all granted'; \
      echo '  </FilesMatch>'; \
      echo '</Directory>'; \
    } > /etc/apache2/conf-enabled/zz-tt-security.conf

# Do not reveal the PHP version in response headers.
RUN echo 'expose_php = Off' > "$PHP_INI_DIR/conf.d/zz-tt-security.ini"

# The web user can read the application but only write compiled templates,
# chart images and temporary import/export files.
RUN chown -R root:root /var/www/html \
 && find /var/www/html -type d -exec chmod 755 {} + \
 && find /var/www/html -type f -exec chmod 644 {} + \
 && chown -R www-data:www-data /var/www/html/WEB-INF/templates_c \
 && chown root:www-data /var/www/html/WEB-INF/config.php \
 && chmod 640 /var/www/html/WEB-INF/config.php
